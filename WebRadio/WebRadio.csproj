<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="WebRadio.user.props" Condition="Exists('WebRadio.user.props')" />
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BassDllLocation Condition="$(BassDllLocation) == ''">$(SolutionDir)\BASS</BassDllLocation>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\avalonia-logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.10" />
    <PackageReference Include="GlobalHotKeys.Windows" Version="0.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="radio42.Bass.Net.core" Version="2.4.17.8" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="11.3.8" />
    <!-- Explicit dependency of Microsoft.Toolkit.Uwp.Notifications to avoid vulnerability in System.Drawing.Common <= 4.7.1 -->
    <PackageReference Include="System.Drawing.Common" Version="4.7.3" />
  </ItemGroup>

  <Target Name="CopyBassDll" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(BassDllLocation)\bass.dll" DestinationFolder="$(TargetDir)" />
  </Target>

  <ItemGroup>
    <EditorConfigFiles Remove="C:\Users\manubop\Documents\Code\WebRadio\WebRadio\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Users\manubop\Documents\Code\WebRadio\WebRadio\.editorconfig" />
  </ItemGroup>
</Project>
