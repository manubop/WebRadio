<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:WebRadio.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WebRadio.Views.StationsView"
			 x:DataType="vm:StationsViewModel"
			 xmlns:local="clr-namespace:WebRadio;assembly=WebRadio"
			 KeyboardNavigation.TabNavigation="None">
	<DockPanel>
		<WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">
			<Button Command="{Binding AddNewItem}">
				Add
			</Button>
			<Button Command="{Binding RemoveSelectedItem}" IsEnabled="{Binding IsItemSelected}">
				Remove
			</Button>
			<Button Command="{Binding EditSelectedItem}" IsEnabled="{Binding IsItemSelected}">
				Edit
			</Button>
			<Button Command="{Binding PlaySelectedItem}" IsEnabled="{Binding IsItemSelected}">
				Play
			</Button>
			<Button Command="{Binding StopItem}" IsEnabled="{Binding IsItemPlaying}">
				Stop
			</Button>
		</WrapPanel>
		<Slider DockPanel.Dock="Top" Maximum="1" Value="{Binding Volume}" Margin="10,0,10,0"/>
		<ListBox ItemsSource="{Binding Model}" SelectedIndex="{Binding SelectedIndex}" DoubleTapped="DoubleTappedHandler">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Concat}"/>
				</DataTemplate>
			</ListBox.ItemTemplate>
			<ListBox.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Edit" Command="{Binding EditSelectedItem}"/>
					<MenuItem Header="Remove" Command="{Binding RemoveSelectedItem}"/>
					<MenuItem Header="Play" Command="{Binding PlaySelectedItem}"/>
				</ContextMenu>
			</ListBox.ContextMenu>
		</ListBox>
	</DockPanel>
</UserControl>
 