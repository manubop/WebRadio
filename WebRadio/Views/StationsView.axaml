<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:WebRadio.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WebRadio.Views.StationsView"
			 x:DataType="vm:StationsViewModel"
			 KeyboardNavigation.TabNavigation="None">
	<DockPanel>
		<WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">
			<Button Command="{Binding AddNewItem}">
				Add
			</Button>
			<Button Command="{Binding RemoveSelectedItemCommand}">
				Remove
			</Button>
			<Button Command="{Binding EditSelectedItemCommand}">
				Edit
			</Button>
			<Button Command="{Binding PlaySelectedItemCommand}">
				Play
			</Button>
			<Button Command="{Binding StopItemCommand}">
				Stop
			</Button>
			<Button Command="{Binding About}">
				About
			</Button>
		</WrapPanel>
		<Slider DockPanel.Dock="Top" Maximum="1" Value="{Binding Volume}" Margin="10,0,10,0"/>
		<ListBox ItemsSource="{Binding Model}" SelectedIndex="{Binding SelectedIndex}" DoubleTapped="DoubleTappedHandler">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Concat}"/>
				</DataTemplate>
			</ListBox.ItemTemplate>
			<ListBox.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Edit" Command="{Binding EditSelectedItemCommand}"/>
					<MenuItem Header="Remove" Command="{Binding RemoveSelectedItemCommand}"/>
					<MenuItem Header="Play" Command="{Binding PlaySelectedItemCommand}"/>
					<MenuItem Header="Move Up" Command="{Binding MoveSelectedItemUpCommand}"/>
					<MenuItem Header="Move Down" Command="{Binding MoveSelectedItemDownCommand}"/>
				</ContextMenu>
			</ListBox.ContextMenu>
			<ListBox.KeyBindings>
				<KeyBinding Gesture="PageUp" Command="{Binding SelectorUp}" CommandParameter="10"/>
				<KeyBinding Gesture="PageDown" Command="{Binding SelectorDown}" CommandParameter="10"/>
			</ListBox.KeyBindings>
		</ListBox>
	</DockPanel>
</UserControl>
 